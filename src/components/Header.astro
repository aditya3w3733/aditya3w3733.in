---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
---

<header>
    <nav>
        <div class="logo-section">
            <a href="/" class="logo-link">
                <img
                    src="/hollow-knight.jpeg"
                    alt="hollow-knight logo"
                    class="knight-logo"
                />
                <h1 class="site-title">Aditya3w3733</h1>
            </a>
        </div>
        <div class="internal-links">
            <HeaderLink href="/posts">Posts</HeaderLink>
        </div>
    </nav>
</header>

<style>
    header {
        margin: 0;
        padding: 0;
        background-color: var(--bg);
        /*border-bottom: 1px solid var(--border);*/
    }

    nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        max-width: 960px;
        margin: 0 auto;
        padding: 0.5rem 1em;
    }

    .logo-section {
        display: flex;
        align-items: center;
    }

    .logo-link {
        display: flex;
        align-items: center;
        gap: 0.1rem;
        text-decoration: none;
    }

    .knight-logo {
        width: 100px;
        height: 100px;
        object-fit: contain;
        image-rendering: pixelated;
        image-rendering: -moz-crisp-edges;
        image-rendering: crisp-edges;
    }

    .site-title {
        margin: 0;
        margin-left: -10px;
        font-size: 1.8rem;
        color: var(--text);
    }

    .logo-link:hover .site-title {
        color: var(--accent);
    }

    .internal-links {
        display: flex;
        gap: 1.5rem;
    }

    @media (max-width: 720px) {
        nav {
            flex-direction: column;
            gap: 1rem;
        }

        .knight-logo {
            width: 40px;
            height: 40px;
        }

        .site-title {
            font-size: 1.5rem;
        }

        .internal-links {
            gap: 1rem;
        }
    }
</style>
