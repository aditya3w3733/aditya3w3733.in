---
const today = new Date();
---

<footer>
    <hr class="footer-separator" />
    <p class="ai-disclaimer">
        All content on this website is handwritten.<br />
    </p>
    <p class="site-info">
        Human written content in an age of generated text.<br />
        Built simple, kept authentic, shared freely.
    </p>
    <div class="footer-bottom">
        <p class="copyright">&copy; {today.getFullYear()} S Aditya</p>
        <a
            href="/rss.xml"
            class="rss-link"
            aria-label="RSS Feed"
            title="Subscribe via RSS"
        >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path
                    d="M6.503 20.752c0 1.794-1.456 3.248-3.251 3.248-1.796 0-3.252-1.454-3.252-3.248 0-1.794 1.456-3.248 3.252-3.248 1.795 0 3.251 1.454 3.251 3.248zm-6.503-12.572v4.811c6.05.062 10.96 4.966 11.022 11.009h4.817c-.062-8.71-7.118-15.758-15.839-15.82zm0-3.368c10.58.046 19.152 8.594 19.183 19.188h4.817c-.03-13.231-10.755-23.954-24-24v4.812z"
                ></path>
            </svg>
        </a>
    </div>
</footer>

<style>
    footer {
        padding: 1.5em 1em 2em 1em;
        text-align: center;
        margin-top: auto;
        color: var(--text-muted);
    }

    .footer-separator {
        border: none;
        border-top: 1px solid var(--border);
        margin: 0 auto 1.5rem auto;
        max-width: 910px;
    }

    footer p {
        margin: 1rem 0;
        line-height: 1.7;
        font-size: 0.9rem;
    }

    .ai-disclaimer {
        font-size: 0.85rem;
        margin-bottom: 1rem;
    }

    .site-info {
        font-size: 0.85rem;
        margin-bottom: 1rem;
    }

    .license {
        font-size: 0.8rem;
        margin-top: 2rem;
    }

    .license a {
        color: var(--accent);
    }

    .license a:hover {
        color: var(--accent-hover);
    }

    .copyright {
        font-size: 0.8rem;
        margin: 0;
    }

    .footer-bottom {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        margin-top: 1rem;
    }

    .rss-link {
        color: var(--accent);
        text-decoration: none;
        display: flex;
        align-items: center;
        transition: color 0.2s ease;
    }

    .rss-link:hover {
        color: var(--accent-hover);
    }
</style>
